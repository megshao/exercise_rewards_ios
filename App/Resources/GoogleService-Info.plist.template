<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  GoogleService-Info.plist 範本。

  真實檔案「不進版控」（見 repo 根目錄 .gitignore）：這個 repo 即將公開，而該檔含有
  Firebase 專案的 API_KEY、GOOGLE_APP_ID、PROJECT_ID 等識別資訊。

  怎麼用：
    1. 到 Firebase Console 建立 iOS App，bundle id 填 com.megshao.sportsrewards
    2. 下載 GoogleService-Info.plist
    3. 放到 App/Resources/GoogleService-Info.plist（就是這個檔案的旁邊）
    4. cd App && xcodegen generate   ← 重跑後檔案才會被掃進 target 並打包進 .app

  沒有真實檔案時：App 照樣可以 build 與執行。Telemetry.configure() 會先檢查
  Bundle.main.path(forResource:"GoogleService-Info", ofType:"plist")，找不到就跳過
  Firebase 初始化，所有遙測 API 變成 no-op（見 App/Sources/App/Telemetry.swift）。
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>REPLACE_WITH_YOUR_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>REPLACE_WITH_YOUR_SENDER_ID</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.megshao.sportsrewards</string>
	<key>PROJECT_ID</key>
	<string>REPLACE_WITH_YOUR_PROJECT_ID</string>
	<key>STORAGE_BUCKET</key>
	<string>REPLACE_WITH_YOUR_PROJECT_ID.appspot.com</string>
	<key>GOOGLE_APP_ID</key>
	<string>REPLACE_WITH_YOUR_GOOGLE_APP_ID</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<false/>
	<key>IS_GCM_ENABLED</key>
	<false/>
	<key>IS_SIGNIN_ENABLED</key>
	<false/>
</dict>
</plist>
